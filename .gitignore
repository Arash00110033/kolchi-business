# ================================
# Kolchi Business - Git Ignore
# ================================

# ================================
# Backend / Python
# ================================
backend/.venv/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]

# Environment / secrets
backend/.env
backend/.env.*
!.env.example

# Local databases
backend/db.sqlite3
backend/*.sqlite3

# Django generated files
backend/media/
backend/staticfiles/

# ================================
# Frontend - Next.js
# ================================
frontend-next/node_modules/
frontend-next/.next/
frontend-next/out/
frontend-next/build/

# Environment / secrets
frontend-next/.env
frontend-next/.env.*
!frontend-next/.env.example

# Logs
frontend-next/*.log
frontend-next/npm-debug.log*
frontend-next/yarn-debug.log*
frontend-next/yarn-error.log*
frontend-next/pnpm-debug.log*

# ================================
# Old Frontend
# ================================
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ================================
# IDE
# ================================
.vscode/
.idea/

# ================================
# OS
# ================================
.DS_Store
Thumbs.db

# ================================
# Aider
# ================================
.aider/
.aider.*
.aider.tags.cache.v4/

# ================================
# Logs
# ================================
*.log

# ================================
# Testing / Coverage
# ================================
.coverage
htmlcov/
.pytest_cache/

# ================================
# Project Archive
# ================================
archive/

# Temporary audit/helper files
audit_project.ps1
frontend-next/_header.txt


# Kolchi local backups and temporary audit files
.kolchi-language-backup*/
frontend-next/backup-*/
**/*.backup-*
**/*.bak
ANALYTICS_TARGET_MAP.txt
PROJECT_MAP.txt
PROJECT_DEEP_MAP.txt
kolchi-backend-audit.txt
kolchi-core-audit.txt
kolchi-frontend-audit.txt
frontend-next/backup-*
