backend/*.py[cod]
backend/**/*.py[cod]
backend/.env
backend/db.sqlite3
backend/*.sqlite3
backend/media/
backend/staticfiles/

# Frontend / Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Aider
.aider/
.aider.*
.aider.tags.cache.v4/

# Logs
*.log

# Testing / Coverage
.coverage
htmlcov/
.pytest_cache/
