# ==========================================
# Kolchi Business — Backend Environment
# ==========================================
# Example environment variables only.
# Never put real production secrets in this file.


# ==========================================
# Django Core
# ==========================================

# Django secret key.
# Generate a strong unique value for each environment.
DJANGO_SECRET_KEY=replace-with-a-strong-secret-key

# Development: True
# Production: False
DJANGO_DEBUG=True

# Comma-separated allowed hosts.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost


# ==========================================
# Localization
# ==========================================

DJANGO_LANGUAGE_CODE=fa-ir
DJANGO_TIME_ZONE=Asia/Tehran


# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=kolchi_db
POSTGRES_USER=kolchi_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# ==========================================
# API
# ==========================================

API_VERSION=v1


# ==========================================
# Security
# ==========================================

# Allowed frontend origins.
# Example:
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trusted origins for Django CSRF protection.
# Example:
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173